{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PackManifest",
  "type": "object",
  "required": ["pack_id", "version", "engine_min", "files"],
  "properties": {
    "pack_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "engine_min": { "type": "string" },
    "files": {
      "type": "object",
      "required": ["grading_scales", "weights", "checks"],
      "properties": {
        "grading_scales": { "type": "string" },
        "weights": { "type": "string" },
        "checks": { "type": "string" }
      }
    }
  }
}
